<odoo>
<record id="view_lease_tree" model="ir.ui.view"><field name="name">lease.tree</field><field name="model">crm.lease.contract</field><field name="arch" type="xml"><tree><field name="name"/><field name="company_id"/><field name="branch_id"/><field name="lessor_name"/><field name="date_start"/><field name="date_end"/><field name="annual_rent_incl_tax"/><field name="state"/><field name="days_remaining"/></tree></field></record>
<record id="view_lease_form" model="ir.ui.view"><field name="name">lease.form</field><field name="model">crm.lease.contract</field><field name="arch" type="xml"><form>
<header>
<button name="action_submit" type="object" string="إرسال للاعتماد" class="btn-primary" invisible="approval_state != 'draft'"/>
<button name="action_approve" type="object" string="اعتماد" class="btn-success" invisible="approval_state != 'submitted'"/>
<button name="action_reject" type="object" string="رفض" class="btn-secondary" invisible="approval_state != 'submitted'"/>
<button name="action_archive_record" type="object" string="أرشفة" class="btn-secondary" invisible="approval_state != 'approved'"/>
<field name="approval_state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,archived"/>
</header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="branch_id"/><field name="signing_date"/><field name="date_start"/><field name="date_end"/><field name="conditional"/><field name="state"/><field name="days_remaining"/></group><group><field name="unit_type"/><field name="area"/><field name="national_address"/></group></group><notebook><page string="المؤجر"><group><group><field name="lessor_name"/><field name="lessor_unified_no"/><field name="lessor_cr_no"/><field name="lessor_cr_date"/></group><group><field name="lessor_rep_name"/><field name="lessor_rep_nationality"/><field name="lessor_rep_identity"/><field name="lessor_rep_mobile"/><field name="lessor_rep_email"/></group></group><field name="lessor_rep_address"/></page><page string="المستأجر"><group><group><field name="tenant_name"/><field name="tenant_nationality"/><field name="tenant_cr_no"/><field name="tenant_unified_no"/><field name="tenant_cr_date"/></group><group><field name="tenant_rep_name"/><field name="tenant_rep_nationality"/><field name="tenant_rep_identity"/><field name="tenant_rep_email"/></group></group><field name="tenant_rep_address"/></page><page string="القيمة المالية"><group><group><field name="rent_total_excl_tax"/><field name="tax_total" readonly="1"/><field name="rent_total_incl_tax" readonly="1"/></group><group><field name="annual_rent_excl_tax"/><field name="annual_tax" readonly="1"/><field name="annual_rent_incl_tax" readonly="1"/><field name="tax_rate"/></group></group></page><page string="المستندات"><field name="attachment_ids" widget="many2many_binary"/></page></notebook><field name="note"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
<record id="action_lease" model="ir.actions.act_window"><field name="name">عقود الإيجار</field><field name="res_model">crm.lease.contract</field><field name="view_mode">tree,form</field></record>
</odoo>
