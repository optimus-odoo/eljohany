<odoo>
<record id="view_company_tree" model="ir.ui.view"><field name="name">crm.company.tree</field><field name="model">crm.company.record</field><field name="arch" type="xml"><tree><field name="name"/><field name="company_type"/><field name="state"/><field name="branch_ids" widget="many2many_tags"/></tree></field></record>
<record id="view_company_form" model="ir.ui.view"><field name="name">crm.company.form</field><field name="model">crm.company.record</field><field name="arch" type="xml"><form><header>
<button name="action_submit" type="object" string="إرسال للاعتماد" class="btn-primary" invisible="workflow_state != 'draft'"/>
<button name="action_approve" type="object" string="اعتماد" class="btn-success" invisible="workflow_state != 'submitted'"/>
<button name="action_reject" type="object" string="رفض" class="btn-secondary" invisible="workflow_state != 'submitted'"/>
<button name="action_archive_record" type="object" string="أرشفة" class="btn-secondary" invisible="workflow_state != 'approved'"/>
<button name="action_unarchive_record" type="object" string="إلغاء الأرشفة" class="btn-secondary" invisible="workflow_state != 'archived'"/>
<field name="workflow_state" widget="statusbar" statusbar_visible="draft,submitted,approved,archived"/>
</header><sheet><div class="oe_button_box"/><widget name="web_ribbon" text="غير نشطة" bg_color="bg-danger" invisible="state == 'active'"/><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="name_en"/><field name="company_type"/><field name="state"/></group><group><field name="branch_ids" widget="many2many_tags"/><field name="note"/></group></group><notebook><page string="الشركاء"><field name="partner_ids"><tree editable="bottom"><field name="name"/><field name="nationality"/><field name="identity_no"/><field name="mobile"/><field name="email"/><field name="birth_date"/><field name="ownership_percent"/><field name="share_value"/><field name="currency_id"/></tree></field></page><page string="المستندات"><field name="attachment_ids" widget="many2many_binary"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
<record id="view_branch_tree" model="ir.ui.view"><field name="name">crm.branch.tree</field><field name="model">crm.company.branch</field><field name="arch" type="xml"><tree><field name="code"/><field name="name"/><field name="company_id"/><field name="city"/><field name="state"/></tree></field></record>
<record id="view_branch_form" model="ir.ui.view"><field name="name">crm.branch.form</field><field name="model">crm.company.branch</field><field name="arch" type="xml"><form><header>
<button name="action_submit" type="object" string="إرسال للاعتماد" class="btn-primary" invisible="workflow_state != 'draft'"/>
<button name="action_approve" type="object" string="اعتماد" class="btn-success" invisible="workflow_state != 'submitted'"/>
<button name="action_reject" type="object" string="رفض" class="btn-secondary" invisible="workflow_state != 'submitted'"/>
<button name="action_archive_record" type="object" string="أرشفة" class="btn-secondary" invisible="workflow_state != 'approved'"/>
<button name="action_unarchive_record" type="object" string="إلغاء الأرشفة" class="btn-secondary" invisible="workflow_state != 'archived'"/>
<field name="workflow_state" widget="statusbar" statusbar_visible="draft,submitted,approved,archived"/>
</header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="company_id"/><field name="state"/><field name="manager"/></group><group><field name="city"/><field name="phone"/><field name="email"/></group></group><notebook><page string="السجلات التجارية"><field name="commercial_registration_ids" widget="many2many_tags"/></page><page string="الرخص البلدية"><field name="municipality_license_ids"/></page><page string="العناوين الوطنية"><field name="national_address_ids"/></page><page string="عدادات الكهرباء"><field name="electricity_meter_ids"/></page><page string="الدفاع المدني"><field name="civil_defense_ids"/></page><page string="الحسابات البنكية"><field name="bank_account_ids"/></page><page string="عقود الإيجار"><field name="lease_contract_ids"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
<record id="action_companies" model="ir.actions.act_window"><field name="name">الشركات</field><field name="res_model">crm.company.record</field><field name="view_mode">tree,form</field></record>
<record id="action_branches" model="ir.actions.act_window"><field name="name">الفروع</field><field name="res_model">crm.company.branch</field><field name="view_mode">tree,form</field></record>
</odoo>
