<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_statement_tree" model="ir.ui.view">
        <field name="name">commission.statement.tree</field>
        <field name="model">commission.statement</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_commission_statement_form" model="ir.ui.view">
        <field name="name">commission.statement.form</field>
        <field name="model">commission.statement</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calculate_from_registered_invoices" string="Calculate From Invoices" type="object" class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'" groups="commission_management.group_commission_manager"/>
                    <button name="action_post_accrual" string="Post Accrual" type="object" class="btn-primary" invisible="state != 'approved'" groups="commission_management.group_commission_finance"/>
                    <button name="action_mark_paid" string="Mark Paid" type="object" invisible="state not in ('approved', 'accrued')" groups="commission_management.group_commission_finance"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled', 'accrued', 'paid')" groups="commission_management.group_commission_manager"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state not in ('submitted', 'approved', 'cancelled')" groups="commission_management.group_commission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,accrued,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_lines" icon="fa-list">
                            <field name="amount_total" widget="statinfo" string="Commission"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="plan_id"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="beneficiary_type"/>
                            <field name="user_id" invisible="beneficiary_type != 'user'" required="beneficiary_type == 'user'"/>
                            <field name="employee_id" invisible="beneficiary_type != 'user'"/>
                            <field name="partner_id" invisible="beneficiary_type != 'partner'" required="beneficiary_type == 'partner'"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commission Lines">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="rule_id"/>
                                    <field name="customer_id"/>
                                    <field name="invoice_id"/>
                                    <field name="base_amount" sum="Base"/>
                                    <field name="commission_amount" sum="Commission"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_commission_statement_search" model="ir.ui.view">
        <field name="name">commission.statement.search</field>
        <field name="model">commission.statement</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="To Approve" name="to_approve" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Salesperson" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_commission_statement" model="ir.actions.act_window">
        <field name="name">Commission Statements</field>
        <field name="res_model">commission.statement</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
