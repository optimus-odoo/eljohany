<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_commission_rule_tree" model="ir.ui.view">
        <field name="name">commission.rule.tree</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="calculation_method"/>
                <field name="rate"/>
                <field name="fixed_amount"/>
                <field name="beneficiary_type"/>
                <field name="team_id"/>
                <field name="product_id"/>
                <field name="product_categ_id"/>
                <field name="target_min_amount"/>
                <field name="target_max_amount"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_commission_rule_form" model="ir.ui.view">
        <field name="name">commission.rule.form</field>
        <field name="model">commission.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="calculation_method"/>
                            <field name="rate" invisible="calculation_method != 'percentage'"/>
                            <field name="fixed_amount" invisible="calculation_method != 'fixed'"/>
                            <field name="tier_mode" invisible="calculation_method != 'tier'"/>
                            <field name="cap_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beneficiary">
                            <group>
                                <field name="beneficiary_type"/>
                                <field name="user_id" invisible="beneficiary_type != 'specific_user'" required="beneficiary_type == 'specific_user'"/>
                                <field name="employee_id" invisible="beneficiary_type not in ('salesperson', 'specific_user', 'team_leader')"/>
                                <field name="partner_id" invisible="beneficiary_type != 'partner'" required="beneficiary_type == 'partner'"/>
                            </group>
                        </page>
                        <page string="Conditions">
                            <group>
                                <group>
                                    <field name="team_id"/>
                                    <field name="customer_id"/>
                                    <field name="customer_tag_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="product_id"/>
                                    <field name="product_categ_id"/>
                                    <field name="min_base_amount"/>
                                    <field name="max_base_amount"/>
                                    <field name="min_margin_percent"/>
                                </group>
                            </group>
                        </page>
                        <page string="Targets">
                            <group>
                                <field name="target_min_amount"/>
                                <field name="target_max_amount"/>
                            </group>
                        </page>
                        <page string="Tiers" invisible="calculation_method != 'tier'">
                            <field name="tier_ids">
                                <tree editable="bottom">
                                    <field name="amount_from"/>
                                    <field name="amount_to"/>
                                    <field name="rate"/>
                                    <field name="fixed_bonus"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_rule" model="ir.actions.act_window">
        <field name="name">Commission Rules</field>
        <field name="res_model">commission.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
