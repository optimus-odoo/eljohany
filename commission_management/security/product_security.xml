<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[('module', '=', 'product'), ('name', '=', 'product_comp_rule')]"/>
        <value eval="{'noupdate': False}"/>
    </function>

    <record id="product.product_comp_rule" model="ir.rule">
        <field name="domain_force">['|', '|', ('company_id', 'parent_of', company_ids), ('company_id', '=', False), ('shared_company_ids', 'in', company_ids)]</field>
    </record>

    <function name="write" model="ir.model.data">
        <value model="ir.model.data" search="[('module', '=', 'product'), ('name', '=', 'product_comp_rule')]"/>
        <value eval="{'noupdate': True}"/>
    </function>

    <record id="rule_product_product_shared_company" model="ir.rule">
        <field name="name">Product variants: shared companies</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">['|', '|', ('company_id', 'parent_of', company_ids), ('company_id', '=', False), ('product_tmpl_id.shared_company_ids', 'in', company_ids)]</field>
    </record>
</odoo>
