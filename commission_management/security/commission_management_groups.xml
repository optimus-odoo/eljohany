<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_commission_management" model="ir.module.category">
        <field name="name">Commission Management</field>
        <field name="description">Access rights for commission plans, statements, and payouts</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_commission_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_commission_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_commission_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_commission_management"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_user'))]"/>
    </record>

    <record id="group_commission_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="module_category_commission_management"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_manager')), (4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_commission_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_commission_management"/>
        <field name="implied_ids" eval="[(4, ref('group_commission_finance'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_commission_line_own_user" model="ir.rule">
        <field name="name">Commission lines: own user lines</field>
        <field name="model_id" ref="model_commission_line"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
    </record>

    <record id="rule_commission_line_manager_all" model="ir.rule">
        <field name="name">Commission lines: managers see all</field>
        <field name="model_id" ref="model_commission_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
    </record>

    <record id="rule_commission_statement_own_user" model="ir.rule">
        <field name="name">Commission statements: own user statements</field>
        <field name="model_id" ref="model_commission_statement"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_commission_user'))]"/>
    </record>

    <record id="rule_commission_statement_manager_all" model="ir.rule">
        <field name="name">Commission statements: managers see all</field>
        <field name="model_id" ref="model_commission_statement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_commission_manager'))]"/>
    </record>
</odoo>
