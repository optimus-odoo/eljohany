<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_invoice_internal_copy" model="report.paperformat">
        <field name="name">Invoice Internal Copy A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">6</field>
        <field name="margin_left">6</field>
        <field name="margin_right">6</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_invoice_seller_copy" model="ir.actions.report">
        <field name="name">نسخة البائع | Seller Copy</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_internal_prints.report_invoice_seller_copy</field>
        <field name="report_file">invoice_internal_prints.report_invoice_seller_copy</field>
        <field name="print_report_name">'Seller Copy - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form,list</field>
        <field name="paperformat_id" ref="paperformat_invoice_internal_copy"/>
    </record>

    <record id="action_report_invoice_warehouse_copy" model="ir.actions.report">
        <field name="name">نسخة أمين المستودع | Warehouse Keeper Copy</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">invoice_internal_prints.report_invoice_warehouse_copy</field>
        <field name="report_file">invoice_internal_prints.report_invoice_warehouse_copy</field>
        <field name="print_report_name">'Warehouse Copy - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form,list</field>
        <field name="paperformat_id" ref="paperformat_invoice_internal_copy"/>
    </record>
</odoo>
