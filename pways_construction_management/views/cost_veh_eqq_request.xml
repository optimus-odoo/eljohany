<odoo>
    <record id="vehicle_equipment_request_tree_view" model="ir.ui.view">
        <field name="name">vehicle.equipment.request.tree.view</field>
        <field name="model">vehicle.equipment.request</field>
        <field name="arch" type="xml">
            <tree create='False'>
                <field name="name"/>
                <field name="description"/>
                <field name="request_type"/>
                <field name="hours" string="Quantity"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="vehicle_equipment_request_form_view" model="ir.ui.view">
        <field name="name">vehicle.equipment.request.form.view</field>
        <field name="model">vehicle.equipment.request</field>
        <field name="arch" type="xml">
            <form string="form" create='False'>
                <header>
                    <!-- <button name='action_draft' type="object" string='Reset to Draft' invisible="state != 'cancel'"/> -->
                    <button name='action_draft' type="object" string='Reset to Draft' />
                    <button name="action_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_create_bill" type="object" string="Create Bill" invisible="state != 'confirm'" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_bills_action" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field string="Bills" name="bill_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="hours" string="Quantity"/>
                            <field name="unit_price" string="Unit Price"/>
                            <field name="request_type" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" />
                    </group>
                    <notebook>
                        <page string="Equipment" invisible="request_type != 'equipment'">
                            <field name="equipment_ids"/>
                        </page>
                        <page string="Fleet" invisible="request_type != 'vehicle'">
                            <field name="fleet_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- <record id="action_view_vehicle_equipment_request" model="ir.actions.act_window">
        <field name="name">Vehicle Equipment Request</field>
        <field name="res_model">vehicle.equipment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_request_type':'vehicle'}</field>
    </record> -->

    
    <record id="action_equipment_request" model="ir.actions.act_window">
        <field name="name">Equipment Request</field>
        <field name="res_model">vehicle.equipment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('request_type','=','equipment')]</field>
        <field name="context">{'default_request_type':'equipment'}</field>
    </record>

    <record id="action_vehicle_request" model="ir.actions.act_window">
        <field name="name">Vehicle Request</field>
        <field name="res_model">vehicle.equipment.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('request_type','=','vehicle')]</field>
        <field name="context">{'default_request_type':'vehicle'}</field>
    </record>

</odoo>