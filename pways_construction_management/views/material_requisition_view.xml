<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
        <record id="material_purchase_requisition_form_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition.form.view</field>
            <field name="model">material.purchase.requisition</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="requisition_confirm" type="object" string="Confirm" invisible="state != 'draft'" class="btn-primary" groups="base.group_user"/>
                        <button name="manager_approve" type="object" string="Department Approve" invisible="state not in ('dept_confirm','cancel','cancel')" class="btn-primary" groups="pways_construction_management.group_purchase_requisition_department"/>
                        <button name="user_approve" type="object" string="Approve" invisible="state != 'ir_approve'" class="btn-primary" groups="pways_construction_management.group_purchase_requisition_user"/>
                        <button name="create_po" type="object" string="Create PO" class="btn-primary" groups="pways_construction_management.group_purchase_requisition_user" invisible="state != 'approve' or requisition_type != 'purchase'"/>
                        <button name="create_picking" type="object" string="Create Picking" class="btn-primary" groups="pways_construction_management.group_purchase_requisition_user" invisible="state != 'approve' or requisition_type != 'internal'"/>
                        <button name="create_store_scrap" 
                                type="object" 
                                string="Store" 
                                class="btn-primary" 
                                groups="pways_construction_management.group_purchase_requisition_user" 
                                invisible="not (state == 'approve' and requisition_type == 'scrap' and scrap_type == 'store')"/>
                        <button name="create_scrap_order" 
                                type="object" 
                                string="Scrap" 
                                class="btn-primary" 
                                groups="pways_construction_management.group_purchase_requisition_user" 
                                invisible="not (state == 'approve' and requisition_type == 'scrap' and scrap_type == 'scrap')"/>
                        <button name="action_received" type="object" string="Received" invisible="state != 'stock'" class="btn-primary"/>
                        <button name="requisition_reject" type="object" string="Reject" groups="pways_construction_management.group_purchase_requisition_department,pways_construction_management.group_purchase_requisition_user" invisible="state not in ('dept_confirm','approve','ir_approve')"/>
                        <button name="action_cancel" type="object" invisible="state != 'draft'" string="Cancel" groups="base.group_user"/>
                        <button name="reset_draft" type="object" string="Reset to Draft" invisible="state not in ('cancel','reject','receive')" class="btn-primary"/>
                        <field name="state" widget="statusbar" string="confirm" statusbar_visible="draft,dept_confirm,ir_approve,approve,stock,receive"/>
                    </header>
                    <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-truck" name="show_picking" string="Internal Picking" groups="base.group_user" invisible="requisition_type != 'internal'"/>
                        <button class="oe_stat_button" type="object" icon="fa-book" name="action_show_po" string="Purchase Order" invisible="requisition_type != 'purchase'"/>
                        <button class="oe_stat_button" type="object" icon="fa-book" name="show_scrap_store_picking" string="Scrap Picking" invisible="not (requisition_type == 'scrap' and scrap_type == 'store')"/>
                        <button class="oe_stat_button" type="object" icon="fa-book" name="show_scrap_order" string="Scrap" invisible="not (requisition_type == 'scrap' and scrap_type == 'scrap')"/>
                    </div>
                    <div class="oe_title">
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/><br/>
                            </h1>
                        </div>
                    </div>
                        <group>
                            <group>
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="department_id" readonly="state != 'draft'"/>
                                <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                                <field name="project_id" readonly="state in ('reject','cancel','receive')"/>
                                <field name="task_id" domain="[('project_id', '=', project_id)]" readonly="state in ('reject','cancel','receive')"/>
                                <field name="task_user_ids" widget="many2many_avatar_user" readonly="state in ('reject','cancel','receive')"/>
                                <field name="purchase_order_ids" invisible="1"/>
                                <field name="job_cost_id"/>
                            </group>
                            <group>
                                <field name="request_date" readonly="state != 'draft'"/>
                                <field name="receive_date" readonly="1"/>
                                <field name="date_end" readonly="1"/>
                                <field name="analytic_account_id" groups="analytic.group_analytic_accounting" readonly="state in ('reject','cancel','receive')"/>
                                <field name="requisiton_responsible_id" readonly="state != 'draft'"/>
                                <field name="requisition_type" readonly="1"/>  
                                <field name="scrap_type" readonly="1" invisible="requisition_type != 'scrap'" widget="radio"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Purchase Requisitions Lines" invisible="requisition_type != 'purchase'">
                                <field name="requisition_line_ids" context="{'default_requisition_type':'purchase'}" readonly="state in ('cancel','receive')">
                                    <tree editable="bottom">
                                        <field name="product_id" domain="[('is_material', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="qty"/>
                                        <field name="uom"/>
                                        <field name="partner_id" groups="pways_construction_management.group_purchase_requisition_user,purchase.group_purchase_user,pways_construction_management.group_purchase_requisition_manager,pways_construction_management.group_purchase_requisition_department" widget="many2many_tags"/>
                                    </tree>
                                </field>
                                <group>
                                    <field name="reason" readonly="state in ('reject','cancel','receive')" placeholder="Add Reason for Internal Requistion ...."/>
                                </group>
                            </page>
                            <page string="Internal Requisitions Lines" invisible="requisition_type != 'internal'">
                                <field name="internal_pick_req_line_ids" context="{'default_requisition_type':'internal'}" readonly="state in ('cancel','receive')">
                                    <tree editable="bottom">
                                        <field name="product_id" domain="[('is_material', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="qty"/>
                                        <field name="uom"/>
                                    </tree>
                                </field>
                                <group>
                                    <field name="reason" readonly="state in ('reject','cancel','receive')" placeholder="Add Reason for Internal Requistion ...."/>
                                </group>
                            </page>
                            <page string="Scrap Requisitions Lines" invisible="requisition_type != 'scrap'">
                                <field name="scrap_req_line_ids" context="{'default_requisition_type':'scrap'}" readonly="state in ('cancel','receive')">
                                    <tree editable="bottom">
                                        <field name="product_id" domain="[('is_material', '=', True)]"/>
                                        <field name="description"/>
                                        <field name="qty"/>
                                        <field name="uom"/>
                                        <field name="tracking" column_invisible="1"/>
                                        <field name="lot_id" invisible="tracking == 'none'"/>
                                    </tree>
                                </field>
                                <group>
                                    <field name="reason" readonly="state in ('reject','cancel','receive')" placeholder="Add Reason for Internal Requistion ...."/>
                                </group>
                            </page>
                            <page groups="pways_construction_management.group_purchase_requisition_user,stock.group_stock_user" string="Picking Details" readonly="state == 'done'" invisible="requisition_type not in ('internal','scrap')">
                                <group>
                                    <group>
                                        <field name="location_id"
                                           groups="pways_construction_management.group_purchase_requisition_user,stock.group_stock_user" 
                                           domain="[('usage','!=', 'view')]" readonly="state in ('reject','cancel','receive')"/>
                                    </group>
                                    <group>
                                        <field name="dest_location_id" groups="pways_construction_management.group_purchase_requisition_user,stock.group_stock_user" readonly="state in ('reject','cancel','receive')"/>
                                        <field name="delivery_picking_id" readonly="1" groups="pways_construction_management.group_purchase_requisition_user,stock.group_stock_user"/>
                                        <field name="custom_picking_type_id" groups="pways_construction_management.group_purchase_requisition_user,stock.group_stock_user" readonly="state in ('reject','cancel','receive')"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Other Information">
                                <group>
                                    <group>
                                        <field name="employee_confirm_id" readonly="1"/>
                                        <field name="approve_manager_id" readonly="1"/>
                                        <field name="approve_employee_id" readonly="1"/>
                                        <field name="reject_employee_id" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="confirm_date" readonly="1"/>
                                        <field name="managerapp_date" readonly="1"/>
                                        <field name="userrapp_date" readonly="1"/>
                                        <field name="userreject_date" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                    </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>
        
        <record id="material_purchase_requisition_tree_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition.view.tree</field>
            <field name="model">material.purchase.requisition</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="request_date"/>
                    <field name="date_end"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>
        
        <record id="material_purchase_requisition_search_view" model="ir.ui.view">
            <field name="name">material.purchase.requisition search</field>
            <field name="model">material.purchase.requisition</field>
            <field name="arch" type="xml">
                <search string="Purchase Requistion search">
                    <field name="employee_id"/>
                    <field name="request_date"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_end"/>
                    <field name="department_id"/>
                    <field name="approve_manager_id"/>
                    <field name="approve_employee_id"/>
                    <field name="location_id"/>
                    <field name="managerapp_date"/>
                    <field name="userrapp_date"/>
                    <field name="receive_date"/>
                    <field name="date_done"/>
                    <field name="dest_location_id"/>
                    <field name="delivery_picking_id"/>
                    <field name="reason"/>
                    <field name="state"/>
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="employee_id" context="{'group_by':'employee_id'}"/>
                        <filter string="Reqisition Date" name="request_date" context="{'group_by':'request_date'}"/>
                        <filter string="Company" name="company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                        <filter string="Reqisition Dedline" name="date_end" context="{'group_by':'date_end'}"/>
                        <filter string="Department" name="department" context="{'group_by':'department_id'}"/>
                        <filter string="Department Manager" name="department_manager" context="{'group_by':'approve_manager_id'}"/>
                        <filter string="Approve By" name="approve_by" context="{'group_by':'approve_employee_id'}"/>
                        <filter string="Location" name="location" context="{'group_by':'location_id'}"/>
                        <filter string="Manager Approve Date" name="managerapp_date" context="{'group_by':'managerapp_date'}"/>
                        <filter string="User Approve Date" name="userapp_date" context="{'group_by':'userrapp_date'}"/>
                        <filter string="Destination Location" name="dest_location_id" context="{'group_by':'dest_location_id'}"/>
                        <filter string="Delivery Picking" name="delivery_picking_id" context="{'group_by':'delivery_picking_id'}"/>
                        <filter string="Reason" name="reason" context="{'group_by':'reason'}"/>
                        <filter string="Date Done" name="date_done" context="{'group_by':'date_done'}"/>
                        <filter string="State" name="state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_material_purchase_requisition_job_costing">
            <field name="name">Material Requisition</field>
            <field name="res_model">material.purchase.requisition</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="action_material_purchase_requisition">
            <field name="name">Purchase</field>
            <field name="res_model">material.purchase.requisition</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_requisition_type':'purchase'}</field>
            <field name="domain">[('requisition_type','=','purchase')]</field>
        </record>
        
        <record model="ir.actions.act_window" id="action_material_int_pick_requisition">
            <field name="name">Internal Picking</field>
            <field name="res_model">material.purchase.requisition</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_requisition_type':'internal'}</field>
            <field name="domain">[('requisition_type','=','internal')]</field>
        </record>

        <record model="ir.actions.act_window" id="action_material_scrap_pick_requisition">
            <field name="name">Scrap Picking</field>
            <field name="res_model">material.purchase.requisition</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_requisition_type':'scrap', 'default_scrap_type':'store',}</field>
            <field name="domain">[('requisition_type','=','scrap'), ('scrap_type','=','store')]</field>
        </record>

        <record model="ir.actions.act_window" id="action_material_scrap_order_requisition">
            <field name="name">Scrap Order</field>
            <field name="res_model">material.purchase.requisition</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_requisition_type':'scrap', 'default_scrap_type':'scrap',}</field>
            <field name="domain">[('requisition_type','=','scrap'),('scrap_type','=','scrap')]</field>
        </record>

    </data>
</odoo>
