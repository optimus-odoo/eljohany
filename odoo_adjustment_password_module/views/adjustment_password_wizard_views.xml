
<odoo>
    <record id="view_adjustment_password_wizard_form" model="ir.ui.view">
        <field name="name">adjustment.password.wizard.form</field>
        <field name="model">adjustment.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Password">
                <group>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_confirm_password" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
