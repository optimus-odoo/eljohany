<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_slow_moving_products" model="report.paperformat">
        <field name="name">Slow Moving Products Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">18</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_slow_moving_products_pdf" model="ir.actions.report">
        <field name="name">تقرير المنتجات الراكدة</field>
        <field name="model">eljohany.slow.moving.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">eljohany_slow_moving_report.report_slow_moving_document</field>
        <field name="report_file">eljohany_slow_moving_report.report_slow_moving_document</field>
        <field name="paperformat_id" ref="paperformat_slow_moving_products"/>
        <field name="print_report_name">'Slow_Moving_Products_%s' % object.report_date</field>
    </record>
</odoo>
