<odoo>
    <record id="res_config_settings_view_form_stock_period_labels" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.stock.period.labels</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="تقارير المخزون" string="تقارير المخزون">
                    <h2>تسميات خاصة بالشركة - تقرير حركة المخزون</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <field name="spr_xlsx_title"/>
                                <field name="spr_label_opening"/>
                                <field name="spr_label_closing"/>
                                <field name="spr_label_in"/>
                                <field name="spr_label_out"/>
                                <field name="spr_label_internal"/>
                                <div class="text-muted">
                                    هذه التسميات تظهر داخل سطور التقرير (الرصيد الافتتاحي/الختامي) وداخل ملف Excel.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
