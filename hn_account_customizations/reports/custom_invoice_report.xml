                            <table class="tbl" style="direction: ltr;">
                                <thead class="tbl-header">
                                    <tr>
                                        <th style="width: 25%;">اﺳﻢ اﻟﺼﻨﻒ<br/>Item Name</th>
                                        <th style="width: 9%;">اﻟﻜﻤﻴﺔ<br/>Quantity</th>
                                        <th style="width: 9%;">ﺳﻌﺮ اﻟﻮﺣﺪة<br/>Unit Price</th>
                                        <th style="width: 12%;">اﻟﻤﺨﺰﻥ<br/>Warehouse</th>
                                        <th style="width: 9%;">اﻟﺴﻌﺮ اﻹﺟﻤﺎﻟﻲ<br/>Total Price</th>
                                        <th style="width: 9%;">اﻟﺨﺼﻢ<br/>Discount</th>
                                        <th style="width: 9%;">اﻟﻤﺒﻠﻎ اﻟﺨﺎﺿﻊ<br/>Taxable Amount</th>
                                        <th style="width: 9%;">ﻣﺒﻠﻎ اﻟﻀﺮﻳﺒﺔ<br/>Tax</th>
                                        <th style="width: 9%;">اﻻﺟﻤﺎﻟﻲ ﺷﺎﻣﻞ<br/>Total (with VAT)</th>
                                    </tr>
                                </thead>
    
                                <tbody>
                                    <t t-foreach="o.invoice_line_ids" t-as="line">
                                        <t t-set="line_total" t-value="line.quantity * line.price_unit"/>
                                        <t t-set="line_discount" t-value="(line_total * line.discount / 100)"/>
                                        <t t-set="line_tax" t-value="line.price_total - line.price_subtotal"/>
                                        
                                        <t t-set="total_line_total" t-value="total_line_total + line_total"/>
                                        <t t-set="total_price_subtotal" t-value="total_price_subtotal + line.price_subtotal"/>
                                        <t t-set="total_discount" t-value="total_discount + line_discount"/>
                                        <t t-set="total_tax" t-value="total_tax + line_tax"/>
                                        <t t-set="total_price_total" t-value="total_price_total + line.price_total"/>
                                        <tr>
                                            <td><span t-esc="line.name"/></td>
                                            <td t-esc="'%.2f' % line.quantity"/>
                                            <td t-esc="'%.2f' % line.price_unit"/>
                                            <td><span t-esc="line.stock_location_id.warehouse_id.name"/></td>
                                            <td t-esc="'%.2f' % line_total"/>
                                            <td t-esc="'%.2f' % line_discount"/>
                                            <td t-esc="'%.2f' % line.price_subtotal"/>
                                            <td t-esc="'%.2f' % line_tax"/>
                                            <td t-esc="'%.2f' % line.price_total"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
    
                            <div style="page-break-inside: avoid;">
                                <table class="tbl" style="margin-top:12px;">
                                    <tr>
                                        <td style="text-align:left; width:40%;">Total - Excluding VAT</td>
                                        <td style="text-align:center; width:20%;" t-esc="'%.2f' % total_line_total">0.00</td>
                                        <td style="width:40%; text-align:right;">اﻻﺟﻤﺎﻟﻲ ﻏﻴﺮ ﺷﺎﻣﻞ ﺿﺮﻳﺒﺔ اﻟﻘﻴﻤﺔ اﻟﻤﻀﺎﻓﺔ</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left;">Discount</td>
                                        <td style="text-align:center;" t-esc="'%.2f' % total_discount">0.00</td>
                                        <td style="width:40%; text-align:right;">إﺟﻤﺎﻟﻲ اﻟﺨﺼﻮﻣﺎت</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left;">Total Taxable Amount</td>
                                        <td style="text-align:center;" t-esc="'%.2f' % total_price_subtotal">0.00</td>
                                        <td style="width:40%; text-align:right;">اﻹﺟﻤﺎﻟﻲ اﻟﺨﺎﺿﻊ ﻟﻠﻀﺮﻳﺒﺔ ﻏﻴﺮ ﺷﺎﻣﻞ ﺿﺮﻳﺒﺔ اﻟﻘﻴﻤﺔ اﻟﻤﻀﺎﻓﺔ</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left;">Total VAT</td>
                                        <td style="text-align:center;" t-esc="'%.2f' % total_tax">0.00</td>
                                        <td style="width:40%; text-align:right;">اﺟﻤﺎﻟﻲ ﺿﺮﻳﺒﺔ اﻟﻘﻴﻤﺔ اﻟﻤﻀﺎﻓﻪ %15</td>
                                    </tr>
                                    <tr>
                                        <td style="text-align:left;">Total Amount Due</td>
                                        <td style="text-align:center;" t-esc="'%.2f' % total_price_total">0.00</td>
                                        <td style="width:40%; text-align:right;">اﻹﺟﻤﺎﻟﻲ اﻟﻤﺴﺘﺤﻖ</td>
                                    </tr>
                                </table>
                            </div>
                            
                            <br/>
                            
                        </div>
    
                        <div style="page-break-inside: avoid;">
                            <div class="custom-invoice-notes mt16" t-attf-style="text-align: #{alignment}; ">
                                <t t-raw="notes"/>
                            </div>
                            <table class="tbl tbl-no-border">
                                <td style="width: 50%" />
                                <td style="width: 50%">
                                    <img t-att-src="image_data_uri(bottom_qrcode)" style="height: 70pt; width: auto; display: block; margin: 0 auto;"/>
                                </td>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    
    <!-- Paper Format -->
    <record id="paperformat_custom_invoice" model="report.paperformat">
        <field name="name">Custom Invoice Format</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="dpi">90</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">25</field>
    </record>

    <!-- Report Action -->
    <record id="action_custom_invoice" model="ir.actions.report">
        <field name="name">Custom Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hn_account_customizations.report_custom_invoice</field>
        <field name="report_file">hn_account_customizations.report_custom_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_custom_invoice"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>


</odoo>