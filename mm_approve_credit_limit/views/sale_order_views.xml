<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="id_view_order_form" model="ir.ui.view">
            <field name="name">sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='partner_id']" position="after">
                        <field name="credit_limit_approved" readonly="1" invisible="1"/>
                        <field name="check_if_credit_limit" readonly="1" invisible="1"/>
                    </xpath>
                    <xpath expr="//button[@name='action_quotation_send']" position="after">

                        <button name="button_approve_credit_limit" type="object" string="Approve Credit Limit"
                                class="btn-primary" invisible="check_if_credit_limit == False or credit_limit_approved == True" groups="edit_sale_order.group_approve_partner_credit_limit"/>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</odoo>