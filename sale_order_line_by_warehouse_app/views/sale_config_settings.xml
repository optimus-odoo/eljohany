<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- add allow warehouse option sale setting -->
    <record model="ir.ui.view" id="res_config_settings_view_form_inherit">
      <field name="name">res.config.settings.form</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
      <field name="arch" type="xml">
          <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
              <setting id="allow_warehouse_id" help="Allow different warehouse for every sale order lines.">
                  <field name="allow_warehouse"/>
              </setting>
          </xpath>
      </field>
    </record>
  </data>
</odoo>
