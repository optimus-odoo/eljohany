<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_location_qty" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.location.qty</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']//tree//field[@name='product_id']" position="after">
                <field name="location_qty" widget="html" readonly="1"
                       attrs="{'invisible': [('picking_type_id.code','!=','internal')]}"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//form//field[@name='product_id']" position="after">
                <field name="location_qty" widget="html" readonly="1"
                       attrs="{'invisible': [('picking_type_id.code','!=','internal')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
