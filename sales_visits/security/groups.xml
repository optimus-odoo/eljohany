<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record model="ir.module.category" id="module_category_visits">
        <field name="name">Visits</field>
        <field name="description">Helps you handle your Visits needs</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_visit_user" model="res.groups">
        <field name="name">Visit User</field>
        <field name="category_id" ref="sales_visits.module_category_visits"/>
    </record>

    <record id="group_visit_manager" model="res.groups">
        <field name="name">Visit Manager</field>
        <field name="category_id" ref="sales_visits.module_category_visits"/>
    </record>
    <data noupdate="1">
        <record model="ir.rule" id="personal_visit_rule">
            <field name="name">Visit personal rule</field>
            <field name="model_id" ref="model_visit_visit"/>
            <field name="groups" eval="[(4, ref('sales_visits.group_visit_user'))]"/>
            <field name="domain_force">[('salesperson_id','=',user.id)]</field>
        </record>

        <record id="multi_company_visit_rule" model="ir.rule">
            <field name="name">Visit multi company rule</field>
            <field name="model_id" ref="model_visit_visit"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        </record>
    </data>
</odoo>