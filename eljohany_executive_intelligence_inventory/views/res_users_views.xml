<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_executive_intelligence_inventory" model="ir.ui.view">
        <field name="name">res.users.form.executive.intelligence.inventory</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="eljohany_executive_intelligence_core.view_users_form_executive_intelligence"/>
        <field name="arch" type="xml">
            <field name="ei_company_ids" position="after">
                <field name="ei_warehouse_ids" widget="many2many_tags" invisible="not ei_custom_access" domain="[('company_id', 'in', company_ids)]"/>
            </field>
        </field>
    </record>
</odoo>

