<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ei_access_profile_form_inventory" model="ir.ui.view">
        <field name="name">executive.intelligence.access.profile.form.inventory</field>
        <field name="model">executive.intelligence.access.profile</field>
        <field name="inherit_id" ref="eljohany_executive_intelligence_core.view_ei_access_profile_form"/>
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <field name="warehouse_ids" widget="many2many_tags" domain="[('company_id', 'in', company_ids)]"/>
            </field>
        </field>
    </record>
    <record id="view_ei_access_profile_tree_inventory" model="ir.ui.view">
        <field name="name">executive.intelligence.access.profile.tree.inventory</field>
        <field name="model">executive.intelligence.access.profile</field>
        <field name="inherit_id" ref="eljohany_executive_intelligence_core.view_ei_access_profile_tree"/>
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <field name="warehouse_ids" widget="many2many_tags" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>

