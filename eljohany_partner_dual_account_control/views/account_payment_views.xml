<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_dual_account_control" model="ir.ui.view">
        <field name="name">account.payment.form.dual.account.control</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']/field[@name='payment_method_line_id']" position="after">
                <field name="destination_account_id"
                       string="Payment Settlement Account"
                       readonly="1"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="is_internal_transfer or not partner_id"/>
                <field name="expected_destination_account_id"
                       readonly="1"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="is_internal_transfer or not partner_id"/>
                <field name="destination_account_control_state"
                       widget="badge"
                       readonly="1"
                       invisible="is_internal_transfer or not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>
