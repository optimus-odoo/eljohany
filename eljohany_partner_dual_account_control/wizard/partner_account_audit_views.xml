<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_account_audit_wizard_view_form" model="ir.ui.view">
        <field name="name">partner.account.audit.wizard.form</field>
        <field name="model">partner.account.audit.wizard</field>
        <field name="arch" type="xml">
            <form string="Partner Directional Account Audit">
                <group>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="partner_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="include_archived"/>
                        <field name="show_valid"/>
                        <field name="checked_partner_count" readonly="1"/>
                        <field name="issue_count" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1" readonly="1">
                    <tree create="0" edit="0" delete="0">
                        <field name="partner_id"/>
                        <field name="direction"/>
                        <field name="account_id"/>
                        <field name="issue_type" widget="badge"/>
                        <field name="details"/>
                        <button name="action_open_partner" type="object"
                                string="Open Partner" icon="fa-external-link"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_run_audit" type="object"
                            string="Run Audit" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="partner_account_audit_wizard_action" model="ir.actions.act_window">
        <field name="name">Partner Directional Account Audit</field>
        <field name="res_model">partner.account.audit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
    </record>

    <menuitem id="partner_account_audit_menu"
              name="Partner Account Audit"
              parent="account.menu_finance_configuration"
              action="partner_account_audit_wizard_action"
              groups="account.group_account_manager"
              sequence="95"/>
</odoo>
