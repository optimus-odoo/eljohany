msgstr "لم يتم إنشاء بند حساب مدين أو دائن للمستند %(document)s."

#. module: eljohany_partner_dual_account_control
msgid "The %(direction)s settlement account for %(partner)s is not valid for company %(company)s."
msgstr "حساب تسوية %(direction)s للشريك %(partner)s غير صالح لشركة %(company)s."

#. module: eljohany_partner_dual_account_control
msgid "The partner settlement account on %(document)s must be %(account)s."
msgstr "يجب أن يكون حساب تسوية الشريك في %(document)s هو %(account)s."

#. module: eljohany_partner_dual_account_control
msgid "The payment account for %(partner)s must be %(account)s or match a document for that partner."
msgstr "يجب أن يكون حساب دفعة الشريك %(partner)s هو %(account)s أو أن يطابق حساب مستند خاص بهذا الشريك."

#. module: eljohany_partner_dual_account_control
msgid "The settlement account for %(partner)s is not valid for company %(company)s."
msgstr "حساب تسوية الشريك %(partner)s غير صالح لشركة %(company)s."

