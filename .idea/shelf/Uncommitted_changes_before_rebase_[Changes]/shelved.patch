+@tagged('post_install', '-at_install')
+class TestCommissionPartialPayments(TransactionCase):
+    @classmethod
+    def setUpClass(cls):
+        super().setUpClass()
+        cls.partner = cls.env['res.partner'].create({'name': 'Partial Payment Customer'})
+        cls.salesperson = cls.env.user
+        cls.bank_journal = cls.env['account.journal'].search([
+            ('company_id', '=', cls.env.company.id),
+            ('type', '=', 'bank'),
+        ], limit=1)
+        cls.income_account = cls.env['account.account'].search([
+            ('company_id', '=', cls.env.company.id),
+            ('account_type', '=', 'income'),
+            ('deprecated', '=', False),
+        ], limit=1)
+        cls.plan = cls.env['commission.plan'].create({
+            'name': 'Paid Trigger Plan',
+            'company_id': cls.env.company.id,
+            'date_start': '2026-01-01',
+            'trigger_type': 'invoice_paid',
+            'base_type': 'invoice_total',
+            'payment_frequency': 'monthly',
+        })
+        cls.rule = cls.env['commission.rule'].create({
+            'name': 'Paid Trigger Rule',
+            'plan_id': cls.plan.id,
+            'calculation_method': 'percentage',
+            'rate': 10.0,
+            'beneficiary_type': 'salesperson',
+        })
+        cls.plan.action_activate()
+
+    def _create_invoice(self):
+        invoice = self.env['account.move'].create({
+            'move_type': 'out_invoice',
+            'partner_id': self.partner.id,
+            'invoice_user_id': self.salesperson.id,
+            'invoice_date': '2026-01-01',
+            'invoice_line_ids': [(0, 0, {
+                'name': 'Paid Trigger Product',
+                'quantity': 1.0,
+                'price_unit': 1000.0,
+                'account_id': self.income_account.id,
+            })],
+        })
+        invoice.action_post()
+        return invoice
+
+    def _register_payment(self, invoice, amount, payment_date):
+        wizard = self.env['account.payment.register'].with_context(
+            active_model='account.move',
+            active_ids=invoice.ids,
+        ).create({
+            'amount': amount,
+            'payment_date': payment_date,
+            'journal_id': self.bank_journal.id,
+        })
+        return wizard._create_payments()
+
+    def _create_statement(self, period_start):
+        return self.env['commission.statement'].create({
+            'company_id': self.env.company.id,
+            'plan_id': self.plan.id,
+            'beneficiary_type': 'user',
+            'user_id': self.salesperson.id,
+            'period_start': period_start,
+        })
+
+    def test_partial_payments_split_commissions_by_payment_month(self):
+        invoice = self._create_invoice()
+        self._register_payment(invoice, 300.0, '2026-01-10')
+        self._register_payment(invoice, 700.0, '2026-02-15')
+
+        january_statement = self._create_statement('2026-01-01')
+        january_statement.action_calculate_from_registered_invoices()
+        january_lines = january_statement.line_ids.filtered(lambda line: line.invoice_id == invoice)
+        self.assertEqual(len(january_lines), 1)
+        self.assertEqual(january_lines.date, fields.Date.to_date('2026-01-10'))
+        self.assertAlmostEqual(january_lines.base_amount, 300.0, places=2)
+        self.assertAlmostEqual(january_lines.commission_amount, 30.0, places=2)
+
+        february_statement = self._create_statement('2026-02-01')
+        february_statement.action_calculate_from_registered_invoices()
+        february_lines = february_statement.line_ids.filtered(lambda line: line.invoice_id == invoice)
+        self.assertEqual(len(february_lines), 1)
+        self.assertEqual(february_lines.date, fields.Date.to_date('2026-02-15'))
+        self.assertAlmostEqual(february_lines.base_amount, 700.0, places=2)
+        self.assertAlmostEqual(february_lines.commission_amount, 70.0, places=2)
