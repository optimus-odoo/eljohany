<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_executive_intelligence" model="ir.module.category">
        <field name="name">Executive Intelligence</field>
        <field name="description">Access to executive and departmental analytics</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_ei_user" model="res.groups">
        <field name="name">Intelligence Center User</field>
        <field name="category_id" ref="module_category_executive_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_ei_admin" model="res.groups">
        <field name="name">Intelligence Center Administrator</field>
        <field name="category_id" ref="module_category_executive_intelligence"/>
        <field name="implied_ids" eval="[(4, ref('group_ei_user'))]"/>
    </record>
</odoo>

