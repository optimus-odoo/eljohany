<odoo>
    <data>
        <record id="id_view_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.hr.fleet</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group/group" position="inside">
                    <field name="name_translate"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Documents">
                        <field name="employee_document_ids">
                            <tree editable="bottom">
                                <field name="name" width="20%"/>
                                <field name="expiration_date" width="20%"/>
                                <field name="days_to_notify" width="20%"/>
                                <field name="d_attachment_ids" widget="many2many_binary"
                                       class="oe_inline" string="Attach a file" width="20%"/>
                                <field name="notify_ids" widget="many2many_tags" width="20%"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>