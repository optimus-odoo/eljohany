<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="id_cron_action_send_notify" model="ir.cron">
            <field name="name">Send Notify (Employee Document)</field>
            <field name="model_id" ref="document_employee.model_employee_document"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model.send_notify_using_date()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
