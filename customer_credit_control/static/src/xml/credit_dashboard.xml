<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="customer_credit_control.CreditDashboard">
        <div class="o_credit_dashboard p-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                    <h2 class="mb-0">لوحة تحكم ائتمان العملاء</h2>
                    <small class="text-muted">منع تأكيد أمر البيع عند تجاوز الحد الائتماني أو وجود فواتير متأخرة حسب المتابعة</small>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary" t-on-click="reload">تحديث</button>
                    <button class="btn btn-outline-danger" t-on-click="cleanupLegacy">تنظيف الفلاتر القديمة</button>
                    <button class="btn btn-outline-warning" t-on-click="openExceeded">عرض المتجاوزين</button>
                    <button class="btn btn-outline-secondary" t-on-click="openOverdue">عرض المتأخرين</button>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-3">
                    <div class="card shadow-sm"><div class="card-body">
                        <div class="text-muted">إجمالي العملاء</div>
                        <div class="display-6"><t t-esc="state.kpis.total_customers"/></div>
                    </div></div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="card shadow-sm"><div class="card-body">
                        <div class="text-muted">تجاوزوا الحد الائتماني</div>
                        <div class="display-6"><t t-esc="state.kpis.exceeded"/></div>
                    </div></div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="card shadow-sm"><div class="card-body">
                        <div class="text-muted">عليهم فواتير متأخرة</div>
                        <div class="display-6"><t t-esc="state.kpis.overdue"/></div>
                    </div></div>
                </div>
                <div class="col-12 col-md-3">
                    <div class="card shadow-sm"><div class="card-body">
                        <div class="text-muted">متأخر + متجاوز</div>
                        <div class="display-6"><t t-esc="state.kpis.both"/></div>
                    </div></div>
                </div>
            </div>

            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h4 class="mb-3">تصنيف نسبة استخدام الائتمان</h4>
                    <div class="row g-2">
                        <t t-foreach="bucketList" t-as="b" t-key="b.label">
                            <div class="col-12 col-md-2">
                                <div class="border rounded p-2">
                                    <div class="text-muted">
                                        <t t-esc="b.label === '0-49' ? '0% - 49%' :
                                                  b.label === '50-79' ? '50% - 79%' :
                                                  b.label === '80-99' ? '80% - 99%' :
                                                  b.label === '100+' ? '100% فأكثر' :
                                                  'بدون حد ائتماني'"/>
                                    </div>
                                    <div class="h4 mb-0"><t t-esc="b.value"/></div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="mb-3">أعلى العملاء مديونية (حسب الرصيد المستحق)</h4>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>العميل</th>
                                    <th class="text-end">الرصيد المستحق</th>
                                    <th class="text-end">الحد الائتماني</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.top" t-as="r" t-key="r.id">
                                    <tr>
                                        <td>
                                            <a href="#" t-on-click.prevent="() => openPartner(r.id)"><t t-esc="r.name"/></a>
                                        </td>
                                        <td class="text-end"><t t-esc="fmtMoney(r.due)"/></td>
                                        <td class="text-end"><t t-esc="fmtMoney(r.limit)"/></td>
                                        <td>
                                            <t t-if="r.overdue and r.exceeded">
                                                <span class="badge bg-danger">متأخر + متجاوز</span>
                                            </t>
                                            <t t-elif="r.exceeded">
                                                <span class="badge bg-warning text-dark">تجاوز الحد</span>
                                            </t>
                                            <t t-elif="r.overdue">
                                                <span class="badge bg-secondary">فواتير متأخرة</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-success">سليم</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="!state.top.length">
                                    <tr><td colspan="4" class="text-center text-muted">لا توجد بيانات</td></tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>
