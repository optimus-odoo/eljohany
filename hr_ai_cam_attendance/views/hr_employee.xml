<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_employee_form_attendance" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hr.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='identification_group']" position="inside">
                <field name="attendance_location" groups="hr.group_hr_manager"/>
                <field name="employee_latitude" groups="hr.group_hr_manager" invisible="attendance_location != 'employee_location'"/>
                <field name="employee_longitude" groups="hr.group_hr_manager" invisible="attendance_location != 'employee_location'"/>
            </xpath>
        </field>
    </record>
</odoo>