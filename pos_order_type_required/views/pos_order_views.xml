<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_form_order_type" model="ir.ui.view">
        <field name="name">pos.order.form.order.type</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']/field[@name='date_order']" position="after">
                <field name="order_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_order_type" model="ir.ui.view">
        <field name="name">pos.order.tree.order.type</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="order_type" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_search_order_type" model="ir.ui.view">
        <field name="name">pos.order.search.order.type</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='config_id']" position="after">
                <field name="order_type"/>
                <filter string="نوع الطلب" name="group_by_order_type" context="{'group_by': 'order_type'}"/>
            </xpath>
        </field>
    </record>
</odoo>
