<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_pos_receipt_alias" model="ir.ui.view">
        <field name="name">res.company.form.pos.receipt.alias</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group[1]" position="after">
                <group string="إعدادات إيصال نقطة البيع" name="pos_receipt_alias_settings">
                    <field name="pos_receipt_use_alias"/>
                    <field
                        name="pos_receipt_alias"
                        placeholder="مثال: الاسم التجاري للفرع"
                        invisible="not pos_receipt_use_alias"
                        required="pos_receipt_use_alias"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
