<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_product_audit_log" model="ir.ui.view">
        <field name="name">product.template.form.product.audit.log</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="product_change_log"
                      string="Change Log"
                      groups="eljohany_product_audit_log.group_product_audit_viewer">
                    <field name="change_log_ids" nolabel="1" readonly="1">
                        <tree create="0" edit="0" delete="0"
                              default_order="changed_on desc, id desc">
                            <field name="changed_on"/>
                            <field name="changed_by_id" widget="many2one_avatar_user"/>
                            <field name="target_model" optional="show"/>
                            <field name="product_id" optional="show"/>
                            <field name="field_display_name"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="field_name" optional="hide"/>
                            <field name="operation_id" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_product_form_product_audit_log" model="ir.ui.view">
        <field name="name">product.product.form.product.audit.log</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="product_variant_change_log"
                      string="Change Log"
                      groups="eljohany_product_audit_log.group_product_audit_viewer">
                    <field name="variant_change_log_ids" nolabel="1" readonly="1">
                        <tree create="0" edit="0" delete="0"
                              default_order="changed_on desc, id desc">
                            <field name="changed_on"/>
                            <field name="changed_by_id" widget="many2one_avatar_user"/>
                            <field name="field_display_name"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="field_name" optional="hide"/>
                            <field name="operation_id" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
