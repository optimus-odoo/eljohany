<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_transfer_view_tree" model="ir.ui.view">
        <field name="name">hr.employee.transfer.tree</field>
        <field name="model">hr.employee.transfer</field>
        <field name="arch" type="xml">
            <tree string="Employee Transfers">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="effective_date"/>
                <field name="from_company_id"/>
                <field name="from_branch_id"/>
                <field name="to_company_id"/>
                <field name="to_branch_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="employee_transfer_view_form" model="ir.ui.view">
        <field name="name">hr.employee.transfer.form</field>
        <field name="model">hr.employee.transfer</field>
        <field name="arch" type="xml">
            <form string="Employee Branch Transfer">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve_and_apply" type="object" string="Approve and Apply Transfer" class="oe_highlight" invisible="state != 'submitted'" groups="eljohany_employee_forms.group_employee_forms_manager" confirm="This will update the employee and linked user's actual company and branch. Continue?"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="eljohany_employee_forms.group_employee_forms_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_cancel" type="object" string="Cancel Scheduled Transfer" invisible="state != 'approved'" groups="eljohany_employee_forms.group_employee_forms_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'cancelled', 'approved', 'application_failed')" groups="eljohany_employee_forms.group_employee_forms_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,applied,application_failed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="employee_id" readonly="state != 'draft'"/>
                        <field name="employee_user_id"/>
                        <field name="effective_date" readonly="state != 'draft'"/>
                    </group>
                    <group>
                        <group string="Current Assignment">
                            <field name="from_company_id"/>
                            <field name="from_branch_id"/>
                            <field name="from_department_id"/>
                            <field name="from_job_id"/>
                            <field name="from_manager_id"/>
                            <field name="from_work_location_id"/>
                        </group>
                        <group string="Destination Assignment">
                            <field name="to_company_id" readonly="state != 'draft'"/>
                            <field name="to_branch_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="to_department_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="to_job_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="to_manager_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="to_work_location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transfer Details">
                            <group>
                                <field name="reason" readonly="state != 'draft'" placeholder="Enter the operational or organizational reason for the transfer..."/>
                                <field name="handover_notes" readonly="state != 'draft'"/>
                                <field name="rejection_reason" invisible="state not in ('submitted', 'rejected')" readonly="state == 'rejected'" groups="eljohany_employee_forms.group_employee_forms_manager"/>
                            </group>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                        </page>
                        <page string="Application Information" invisible="state != 'applied'">
                            <group>
                                <field name="approved_by"/>
                                <field name="applied_by"/>
                                <field name="applied_at"/>
                            </group>
                        </page>
                        <page string="Application Error" invisible="state != 'application_failed'" groups="eljohany_employee_forms.group_employee_forms_manager">
                            <group>
                                <field name="application_failed_at"/>
                                <field name="application_error"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="employee_transfer_view_search" model="ir.ui.view">
        <field name="name">hr.employee.transfer.search</field>
        <field name="model">hr.employee.transfer</field>
        <field name="arch" type="xml">
            <search string="Employee Transfers">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="to_company_id" invisible="1"/>
                <field name="from_branch_id"/>
                <field name="to_branch_id"/>
                <filter name="my_transfers" string="My Transfers" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="pending" string="Pending Approval" domain="[('state', 'in', ('submitted', 'approved', 'application_failed'))]"/>
                <separator/>
                <filter name="group_destination" string="Destination Branch" context="{'group_by': 'to_branch_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="employee_transfer_action" model="ir.actions.act_window">
        <field name="name">Employee Transfers</field>
        <field name="res_model">hr.employee.transfer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="employee_transfer_view_search"/>
        <field name="groups_id" eval="[(4, ref('eljohany_employee_forms.group_employee_forms_user'))]"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create an employee transfer between companies or branches.</p></field>
    </record>
</odoo>
