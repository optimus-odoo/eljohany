<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form_branch" model="ir.ui.view">
        <field name="name">hr.employee.form.branch</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][1]" position="after">
                <field name="company_id" invisible="1"/>
                <field name="branch_id" options="{'no_create': True}" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
