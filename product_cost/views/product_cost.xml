<odoo>
    <data>
        <record id="product_template_form_inherit" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='taxes_id']" position="before">
                    <field name="min_cost" groups="product_cost.product_cost_access"/>
                    <field name="max_cost" groups="product_cost.product_cost_access"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_inherit" model="ir.ui.view">
            <field name="name">sale.order.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook//page[@name='order_lines']//field[@name='order_line']//tree//field[@name='price_unit']"
                       position="after">
                    <field name="min_price" optional="1" groups="product_cost.product_cost_access"/>
                    <field name="max_price" optional="1" groups="product_cost.product_cost_access"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>