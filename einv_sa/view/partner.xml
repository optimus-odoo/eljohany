<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- form view -->
        <record id="view_res_partner_form" model="ir.ui.view">
            <field name="name">res_partner_form</field>
            <field name="model">res.partner</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='zip']" position="replace"></xpath>
                <xpath expr="//field[@name='city']" position="replace"></xpath>
                <xpath expr="//field[@name='state_id']" position="replace"></xpath>
                <!--class="o_address_zip"-->
                <xpath expr="//field[@name='street2']" position="after">
                    <field name="district" placeholder="District"></field>
                    <div class="d-flex justify-content-start">
                        <field name="zip" placeholder="ZIP" class="mr-2"
                               readonly="type == 'contact' and not parent_id "/>
                        <field name="additional_no" placeholder="Additional No" class="mr-2"
                               readonly="type == 'contact' and not parent_id "/>
                        <field name="building_no" placeholder="Building No"
                               readonly="type == 'contact' and not parent_id "/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='country_id']" position="after">
                    <div class="d-flex justify-content-start">
                        <field name="city" placeholder="City" class="mr-3"
                               readonly="type == 'contact' and not parent_id "/>
                        <field name="state_id" placeholder="State"
                               options="{'no_open': True, 'no_quick_create': True}"
                               readonly="type == 'contact' and not parent_id "
                               context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="other_id"></field>
                    <field name="one_time_customer"/>
                </xpath>
            </field>
        </record>
        <record id="id_view_sale_order_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.repair</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="one_time_customer" invisible="1"/>
                    <field name="one_time_name" invisible="one_time_customer != True"/>
                    <field name="one_time_phone" invisible="one_time_customer != True"/>
                </xpath>
            </field>
        </record>
        <record model="ir.ui.view" id="id_id_view_account_invoice_form">
            <field name="name">Account Invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
                    <field name="one_time_customer" invisible="1"/>
                    <field name="one_time_name" invisible="one_time_customer != True"/>
                    <field name="one_time_phone" invisible="one_time_customer != True"/>
                </xpath>
            </field>
        </record>

