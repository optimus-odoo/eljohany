                                        <strong>Invoice Type</strong>
                                    </div>
                                    <div class="col-4 text-center">
                                        <t t-if="doc.payment_state == 'paid'">
                                            <span>كاش</span>
                                        </t>
                                        <t t-elif="doc.payment_state != 'paid'">
                                            <span>آجل</span>
                                        </t>
                                    </div>
                                    <div class="col-4 text-right">
                                        <strong>حالة الفاتورة</strong>
                                    </div>
                                </div>
                            </div>
                            <!-- QR Code -->
