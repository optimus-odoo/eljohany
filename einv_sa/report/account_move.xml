<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="id_view_move_form_inherit_move_account" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@id='invoice_tab']//field[@name='invoice_line_ids']//tree//field[@name='price_unit']"
                       position="after">
                    <field name="total_price" invisible="1"/>
                </xpath>
            </field>
        </record>
        <record id="id_paper_format_account_invoice_taxes" model="report.paperformat">
            <field name="name">Account invoice Tax</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">30</field>
            <field name="margin_bottom">40</field>
            <field name="margin_left">1</field>
            <field name="margin_right">1</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">25</field>
            <field name="dpi">90</field>
        </record>
        <record id="action_tax_invoice_report" model="ir.actions.report">
            <field name="name">Tax Invoice - فاتورة ضريبية</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">einv_sa.account_move_report</field>
            <field name="report_file">einv_sa.account_move_report</field>
            <field name="print_report_name">'Invoice - %s' % (object.name).replace('/', '')</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id"
                   ref="einv_sa.id_paper_format_account_invoice_taxes"/>

        </record>

        <template id="einv_sa.account_move_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.basic_layout" style="font-family: serif">
                        <div class="header container" style="padding: 0;">
                            <br/>
                            <div class="row align-items-center" style="margin: 0;">
                                <!-- القسم الإنجليزي -->
                                <div class="col-5" style="text-align: left; line-height: 1.6; padding: 0;">
                                    <h5 style="color: black; font-weight: bolder; font-size: 14px; text-decoration: underline; margin: 0;">
                                        Mohammed Salman A.Aljohani Trading Company
                                    </h5>
                                    <p style="margin: 0; text-align: left;">
                                        C.R.:4030246583
                                    </p>
                                </div>
                                <div class="col-2" style="text-align: center;">
                                    <img t-att-src="image_data_uri(doc.company_id.logo)"
                                         style="height: 80px; max-width: 100%; object-fit: contain;"
                                         alt="Logo"/>
                                </div>
                                <!-- القسم العربي -->
                                <div class="col-5"
                                     style="text-align: right; direction: rtl; line-height: 1.6; padding: 0;">
                                    <h5 style="color: black; font-weight: bolder; font-size: 16px; text-decoration: underline; margin: 0;">
                                        شركة محمد سليمان عبدالله الجهني التجارية
                                    </h5>
                                    <p style="margin: 0; text-align: right;font-size: 14px;">
                                        براس مال قدرة : 10000000 مليون ريال سعودي
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="row p-1 my-2 border-bottom bg-light">
                            <div class="col-9 text-center" style="font-size:1.2rem;">
                                <strong>Tax Invoice فاتورة ضريبية</strong>
                                <span t-if="doc.move_type=='out_refund'">- Credit Note إشعار دائن</span>
                                <span t-if="doc.move_type=='in_refund'">- Debit Note إشعار مدين</span>
                            </div>
                        </div>
                        <!-- معلومات الفاتورة -->
                        <div class="row my-1">
                            <div class="col-9">
                                <div class="row">
                                    <div class="col-4">
                                        <strong>Invoice Number</strong>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span t-field="doc.name"></span>
                                    </div>
                                    <div class="col-4 text-right">
                                        <strong>رقم الفاتورة</strong>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <strong>Invoice Date</strong>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span t-field="doc.invoice_date"></span>
                                    </div>
                                    <div class="col-4 text-right">
                                        <strong>تاريخ الفاتورة</strong>
                                    </div>
                                </div>
                                <div class="row">
