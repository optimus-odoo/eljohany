<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="fleet_vehicle_accident_rule_user" model="ir.rule">
            <field name="name">Vehicle accident: user vehicle only</field>
            <field name="model_id" ref="model_fleet_vehicle_accident"/>
            <field name="groups" eval="[(4, ref('fleet.fleet_group_user'))]"/>
            <field name="domain_force">[('vehicle_id.driver_id', '=', user.partner_id.id)]</field>
        </record>

        <record id="fleet_vehicle_accident_rule_manager" model="ir.rule">
            <field name="name">Vehicle accident: manager all vehicles</field>
            <field name="model_id" ref="model_fleet_vehicle_accident"/>
            <field name="groups" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="fleet_vehicle_accident_rule_company" model="ir.rule">
            <field name="name">Vehicle accident: multi company</field>
            <field name="model_id" ref="model_fleet_vehicle_accident"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('vehicle_id.company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
