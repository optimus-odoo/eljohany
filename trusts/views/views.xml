<odoo>
    <data>
        <record id="id_inherit_sale_order_form_tru" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/div[3]" position="after">
                    <field name="is_trust" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="am_seq" readonly="1" invisible="is_trust != True"/>
                        </h1>
                    </div>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="is_trust" readonly="state != 'draft'" widget="boolean_toggle"/>/>
                </xpath>
            </field>
        </record>
        <record id="id__stock_picking_form_id" model="ir.ui.view">
            <field name="name">edit.stock.stock.picking.form</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="before">
                    <div class="oe_title">
                        <h1>
                            <field name="am_seq" readonly="1" invisible="is_trust != True"/>
                        </h1>
                    </div>
                </xpath>
                <xpath expr="//group/group[2]" position="inside">
                    <field name="is_trust" readonly="state  not in  ('draft','waiting')" widget="boolean_toggle"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
