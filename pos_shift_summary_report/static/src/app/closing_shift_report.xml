<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_shift_summary_report.ClosePosPopup"
       t-inherit="point_of_sale.ClosePosPopup"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'modal-footer-right')]/button[@t-on-click='downloadSalesReport']"
               position="before">
            <button class="button icon btn btn-lg btn-secondary"
                    t-on-click="downloadShiftReport"
                    title="Download the shift report without closing or changing the POS session">
                Shift Report
                <i class="fa fa-file-pdf-o" role="img"/>
            </button>
        </xpath>
    </t>
</templates>
