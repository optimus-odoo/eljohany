<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pos_shift_summary_report" model="report.paperformat">
        <field name="name">POS Shift Summary - 80mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">80</field>
        <field name="page_height">297</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_pos_shift_summary_report_pdf" model="ir.actions.report">
        <field name="name">POS Shift Summary Report</field>
        <field name="model">pos.shift.summary.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_shift_summary_report.report_pos_shift_summary</field>
        <field name="report_file">pos_shift_summary_report.report_pos_shift_summary</field>
        <field name="paperformat_id" ref="paperformat_pos_shift_summary_report"/>
        <field name="print_report_name">object._get_report_filename()</field>
    </record>

    <record id="action_pos_session_shift_summary_report_pdf" model="ir.actions.report">
        <field name="name">POS Shift Summary Report</field>
        <field name="model">pos.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_shift_summary_report.session_shift</field>
        <field name="report_file">pos_shift_summary_report.session_shift</field>
        <field name="paperformat_id" ref="paperformat_pos_shift_summary_report"/>
        <field name="print_report_name">object._get_closing_shift_report_filename()</field>
    </record>
</odoo>
