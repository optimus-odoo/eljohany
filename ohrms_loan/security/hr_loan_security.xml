<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_employee_forms_access" model="res.groups">
        <field name="name">Employee Forms Access</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Allows an employee to submit and follow only their own loan requests.</field>
    </record>
    <record id="group_loan_approver" model="res.groups">
        <field name="name">Loan Workflow Approver</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Automatically granted to users selected in loan approval workflow steps.</field>
    </record>
    <data noupdate="0">
        <record id="hr_loan_rule_company_v2" model="ir.rule">
            <field name="name">Loan requests: allowed companies</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_loan_rule_employee_v2" model="ir.rule">
            <field name="name">Loan requests: employee own records</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ohrms_loan.group_employee_forms_access'))]"/>
        </record>
        <record id="hr_loan_rule_approver" model="ir.rule">
            <field name="name">Loan requests: assigned approver records</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[('approval_line_ids.approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ohrms_loan.group_loan_approver'))]"/>
        </record>
        <record id="hr_loan_rule_hr" model="ir.rule">
            <field name="name">Loan requests: HR allowed companies</field>
            <field name="model_id" ref="model_hr_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
        <record id="hr_loan_line_rule_company" model="ir.rule">
            <field name="name">Loan installments: allowed companies</field>
            <field name="model_id" ref="model_hr_loan_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('loan_id.company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_loan_line_rule_employee" model="ir.rule">
            <field name="name">Loan installments: employee own records</field>
            <field name="model_id" ref="model_hr_loan_line"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ohrms_loan.group_employee_forms_access'))]"/>
        </record>
        <record id="hr_loan_line_rule_approver" model="ir.rule">
            <field name="name">Loan installments: assigned approver records</field>
            <field name="model_id" ref="model_hr_loan_line"/>
            <field name="domain_force">[('loan_id.approval_line_ids.approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ohrms_loan.group_loan_approver'))]"/>
        </record>
        <record id="hr_loan_line_rule_hr" model="ir.rule">
            <field name="name">Loan installments: HR allowed companies</field>
            <field name="model_id" ref="model_hr_loan_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
        <record id="hr_loan_approval_line_rule_company" model="ir.rule">
            <field name="name">Loan approval history: allowed companies</field>
            <field name="model_id" ref="model_hr_loan_approval_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_loan_approval_line_rule_employee" model="ir.rule">
            <field name="name">Loan approval history: employee own records</field>
            <field name="model_id" ref="model_hr_loan_approval_line"/>
            <field name="domain_force">[('loan_id.employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ohrms_loan.group_employee_forms_access'))]"/>
        </record>
        <record id="hr_loan_approval_line_rule_approver" model="ir.rule">
            <field name="name">Loan approval history: assigned approver records</field>
            <field name="model_id" ref="model_hr_loan_approval_line"/>
            <field name="domain_force">[('loan_id.approval_line_ids.approver_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('ohrms_loan.group_loan_approver'))]"/>
        </record>
        <record id="hr_loan_approval_line_rule_hr" model="ir.rule">
            <field name="name">Loan approval history: HR allowed companies</field>
            <field name="model_id" ref="model_hr_loan_approval_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
        <record id="hr_loan_workflow_rule_company" model="ir.rule">
            <field name="name">Loan workflows: allowed companies</field>
            <field name="model_id" ref="model_hr_loan_workflow"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('ohrms_loan.group_loan_approver'))]"/>
        </record>
        <record id="hr_loan_workflow_step_rule_company" model="ir.rule">
            <field name="name">Loan workflow steps: allowed companies</field>
            <field name="model_id" ref="model_hr_loan_workflow_step"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('ohrms_loan.group_loan_approver'))]"/>
        </record>
    </data>
</odoo>
