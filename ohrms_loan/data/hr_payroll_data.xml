<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="hr_loan_input_type" model="hr.payslip.input.type">
        <field name="name">Loan</field>
        <field name="code">LO</field>
    </record>

    <record id="hr_rule_loan" model="hr.salary.rule">
        <field name="name">Loan</field>
        <field name="struct_id" ref="hr_payroll.structure_002"/>
        <field name="sequence" eval="190"/>
        <field name="code">LO</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = 'LO' in inputs</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = -inputs['LO'].amount</field>
    </record>
</odoo>
