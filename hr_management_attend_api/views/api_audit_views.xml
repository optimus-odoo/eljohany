<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="api_event_tree" model="ir.ui.view">
        <field name="name">hr.attendance.api.event.tree</field>
        <field name="model">hr.attendance.api.event</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="event_at"/>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="event_type"/>
                <field name="period"/>
                <field name="accuracy"/>
                <field name="distance"/>
                <field name="request_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="api_event_form" model="ir.ui.view">
        <field name="name">hr.attendance.api.event.form</field>
        <field name="model">hr.attendance.api.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="idempotency_key"/>
                            <field name="event_at"/>
                            <field name="event_type"/>
                            <field name="period"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="attendance_id"/>
                            <field name="branch_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="token_id"/>
                        </group>
                    </group>
                    <group string="GPS Evidence">
                        <field name="latitude"/>
                        <field name="longitude"/>
                        <field name="accuracy"/>
                        <field name="distance"/>
                        <field name="source_ip"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_event_search" model="ir.ui.view">
        <field name="name">hr.attendance.api.event.search</field>
        <field name="model">hr.attendance.api.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="branch_id"/>
                <field name="request_id"/>
                <filter name="check_in" string="Check In" domain="[('event_type', '=', 'check_in')]"/>
                <filter name="check_out" string="Check Out" domain="[('event_type', '=', 'check_out')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'event_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="api_event_action" model="ir.actions.act_window">
        <field name="name">API Attendance Events</field>
        <field name="res_model">hr.attendance.api.event</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="api_event_search"/>
    </record>

    <record id="api_token_tree" model="ir.ui.view">
        <field name="name">hr.attendance.api.token.tree</field>
        <field name="model">hr.attendance.api.token</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0">
                <field name="name"/>
                <field name="role"/>
                <field name="user_id" optional="hide"/>
                <field name="employee_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="expires_at"/>
                <field name="revoked_at"/>
                <field name="last_used_at"/>
            </tree>
        </field>
    </record>

    <record id="api_token_form" model="ir.ui.view">
        <field name="name">hr.attendance.api.token.form</field>
        <field name="model">hr.attendance.api.token</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="role"/>
                            <field name="user_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="expires_at"/>
                            <field name="revoked_at"/>
                            <field name="last_used_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_token_action" model="ir.actions.act_window">
        <field name="name">API Tokens</field>
        <field name="res_model">hr.attendance.api.token</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="api_sync_log_tree" model="ir.ui.view">
        <field name="name">hr.attendance.api.sync.log.tree</field>
        <field name="model">hr.attendance.api.sync.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="started_at"/>
                <field name="state" widget="badge"/>
                <field name="trigger"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="branch_id" optional="hide"/>
                <field name="employee_id" optional="hide"/>
                <field name="shift" optional="hide"/>
                <field name="fetched_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="failed_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="api_sync_log_form" model="ir.ui.view">
        <field name="name">hr.attendance.api.sync.log.form</field>
        <field name="model">hr.attendance.api.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Successful"
                        bg_color="text-bg-success"
                        invisible="state != 'success'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Partial"
                        bg_color="text-bg-warning"
                        invisible="state != 'partial'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Failed"
                        bg_color="text-bg-danger"
                        invisible="state != 'failed'"
                    />
                    <widget
                        name="web_ribbon"
                        title="Already Running"
                        bg_color="text-bg-info"
                        invisible="state != 'skipped'"
                    />
                    <div class="oe_title">
                        <label for="name" string="Synchronization"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope">
                            <field name="state" widget="badge"/>
                            <field name="trigger"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="employee_id"/>
                            <field name="shift"/>
                        </group>
                        <group string="Execution">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <separator string="Results"/>
                    <div class="row g-2 o_attendance_sync_log_metrics">
                        <div class="col-6 col-md-4 col-xl">
                            <div class="o_attendance_sync_metric o_attendance_sync_metric_fetched">
                                <span class="text-muted">Fetched</span>
                                <field name="fetched_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl">
                            <div class="o_attendance_sync_metric o_attendance_sync_metric_created">
                                <span class="text-muted">Created</span>
                                <field name="created_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl">
                            <div class="o_attendance_sync_metric o_attendance_sync_metric_updated">
                                <span class="text-muted">Updated</span>
                                <field name="updated_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl">
                            <div class="o_attendance_sync_metric o_attendance_sync_metric_skipped">
                                <span class="text-muted">Skipped</span>
                                <field name="skipped_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-xl">
                            <div class="o_attendance_sync_metric o_attendance_sync_metric_failed">
                                <span class="text-muted">Failed</span>
                                <field name="failed_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <group class="mt-3" col="4">
                        <field name="branch_count"/>
                        <field name="employee_count"/>
                    </group>
                    <separator string="Details"/>
                    <field
                        name="message"
                        nolabel="1"
                        readonly="1"
                        class="o_attendance_sync_log_details"
                        invisible="not message"
                    />
                    <div class="alert alert-success mb-0" role="alert" invisible="message">
                        No warnings or errors were recorded for this synchronization.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="api_sync_log_search" model="ir.ui.view">
        <field name="name">hr.attendance.api.sync.log.search</field>
        <field name="model">hr.attendance.api.sync.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="partial" string="Partial" domain="[('state', '=', 'partial')]"/>
                <filter name="skipped" string="Already Running" domain="[('state', '=', 'skipped')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="api_sync_log_action" model="ir.actions.act_window">
        <field name="name">Attendance Pull Logs</field>
        <field name="res_model">hr.attendance.api.sync.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="api_sync_log_search"/>
    </record>

    <menuitem
        id="menu_attendance_api"
        name="Attendance API"
        parent="hr_attendance.menu_hr_attendance_root"
        sequence="80"
        groups="hr_management_attend_api.group_attendance_api_admin,base.group_system"
    />
    <menuitem
        id="menu_attendance_api_events"
        name="API Events"
        parent="menu_attendance_api"
        action="api_event_action"
        sequence="10"
    />
    <menuitem
        id="menu_attendance_api_tokens"
        name="API Tokens"
        parent="menu_attendance_api"
        action="api_token_action"
        sequence="20"
    />
    <menuitem
        id="menu_attendance_api_sync_logs"
        name="Attendance Pull Logs"
        parent="menu_attendance_api"
        action="api_sync_log_action"
        sequence="30"
        groups="hr_management_attend_api.group_attendance_api_admin,base.group_system"
    />
</odoo>
