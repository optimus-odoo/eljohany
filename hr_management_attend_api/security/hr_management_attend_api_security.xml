<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_attendance_api_admin" model="res.groups">
        <field name="name">Attendance API Administrator</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="rule_api_credential_company" model="ir.rule">
        <field name="name">Attendance API credentials by company</field>
        <field name="model_id" ref="model_hr_attendance_api_credential"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_api_admin'))]"/>
    </record>

    <record id="rule_api_token_company" model="ir.rule">
        <field name="name">Attendance API tokens by company</field>
        <field name="model_id" ref="model_hr_attendance_api_token"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_api_admin'))]"/>
    </record>

    <record id="rule_api_event_company" model="ir.rule">
        <field name="name">Attendance API events by company</field>
        <field name="model_id" ref="model_hr_attendance_api_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_attendance_api_admin'))]"/>
    </record>

    <record id="rule_api_sync_log_company" model="ir.rule">
        <field name="name">Attendance API synchronization logs by company</field>
        <field name="model_id" ref="model_hr_attendance_api_sync_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_attendance_api_admin')])]"/>
    </record>

    <record id="rule_api_sync_log_system" model="ir.rule">
        <field name="name">Attendance API synchronization logs for system administrators</field>
        <field name="model_id" ref="model_hr_attendance_api_sync_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
</odoo>
