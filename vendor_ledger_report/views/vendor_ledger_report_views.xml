<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_ledger_report_wizard_form" model="ir.ui.view">
        <field name="name">vendor.ledger.report.wizard.form</field>
        <field name="model">vendor.ledger.report.wizard</field>
        <field name="arch" type="xml">
            <form string="كشف حساب الموردين الشامل">
                <sheet>
                    <div class="oe_title">
                        <h1>كشف حساب الموردين الشامل</h1>
                    </div>
                    <group>
                        <group string="نطاق التقرير">
                            <field name="company_id" string="الشركة"
                                   groups="base.group_multi_company"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="show_all_suppliers" string="إظهار جميع الموردين"/>
                            <field name="partner_id" string="المورد"
                                   invisible="show_all_suppliers"
                                   required="not show_all_suppliers"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="display_mode" string="خيار عرض التقرير"/>
                        </group>
                        <group string="الفترة المحاسبية">
                            <field name="date_from" string="من تاريخ"/>
                            <field name="date_to" string="إلى تاريخ"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        يتم تحديد الفترة بحسب تاريخ القيد. يعرض التقرير القيود المرحلة فقط، ويشمل جميع الحسابات المرتبطة بالمورد دون تقييدها بحسابات الدائنين.
                    </div>
                </sheet>
                <footer>
                    <button name="action_view_report"
                            string="عرض التقرير"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_print_pdf"
                            string="تنزيل بصيغة PDF"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_export_excel"
                            string="تصدير بصيغة Excel"
                            type="object"
                            class="btn-secondary"/>
                    <button string="إغلاق" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vendor_ledger_report_wizard" model="ir.actions.act_window">
        <field name="name">كشف حساب الموردين الشامل</field>
        <field name="res_model">vendor.ledger.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <menuitem id="menu_vendor_ledger_report"
              name="كشف حساب الموردين الشامل"
              parent="account.menu_finance_reports"
              action="action_vendor_ledger_report_wizard"
              groups="account.group_account_user"
              sequence="35"/>
</odoo>
