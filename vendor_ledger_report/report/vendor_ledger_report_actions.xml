<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_vendor_ledger_report" model="report.paperformat">
        <field name="name">كشف حساب الموردين - A4 أفقي</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_vendor_ledger_report_pdf" model="ir.actions.report">
        <field name="name">كشف حساب الموردين الشامل</field>
        <field name="model">vendor.ledger.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vendor_ledger_report.vendor_ledger_report_pdf</field>
        <field name="report_file">vendor_ledger_report.vendor_ledger_report_pdf</field>
        <field name="paperformat_id" ref="paperformat_vendor_ledger_report"/>
        <field name="print_report_name">'كشف_حساب_الموردين_%s_%s' % (object.date_from.strftime('%Y%m%d'), object.date_to.strftime('%Y%m%d'))</field>
    </record>

    <record id="action_vendor_ledger_report_html" model="ir.actions.report">
        <field name="name">عرض كشف حساب الموردين</field>
        <field name="model">vendor.ledger.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">vendor_ledger_report.vendor_ledger_report_pdf</field>
        <field name="report_file">vendor_ledger_report.vendor_ledger_report_pdf</field>
        <field name="paperformat_id" ref="paperformat_vendor_ledger_report"/>
    </record>
</odoo>
